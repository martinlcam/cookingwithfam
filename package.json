{
  "name": "cookingwithfam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "phaser": "^3.90.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
