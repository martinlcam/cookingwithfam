{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/no-non-null-assertion": "off"
  },
  "ignorePatterns": [
    "dev-dist",
    "dev-dist/**",
    "dist",
    "dist/**",
    "node_modules",
    "tools/**"
  ]
}
